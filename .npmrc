# https://docs.npmjs.com/cli/v12/using-npm/config
# https://docs.npmjs.com/cli/v12/using-npm/changelog
# https://github.com/npm/cli/releases
#  https://github.com/npm/cli/releases/tag/v12.0.0

install-strategy = linked
strict-peer-deps = true

############################################################
######################### SECURITY #########################
############################################################

# This will disable any fs writes, network access, process
#  spawning and rtc. Only allows to read files in cwd.
# Works for all postinstall and preinstall scripts too.
node-options = --permission --allow-fs-read=.

# Turn the install-script policy from a warning into a hard
#  error: any dependency with install scripts that is not
#  covered by allowScripts will fail the install instead of
#  being blocked with a warning.
strict-allow-scripts = true

# Do not install packages younger then 1 day
min-release-age = 1

# Limits the ability for npm to install dependencies from local directories.
allow-directory = root

# Limits the ability for npm to install dependencies from local tarball files.
allow-file = root

# Limits the ability for npm to fetch dependencies from git references.
allow-git = root

# Limits the ability for npm to fetch dependencies from urls.
allow-remote = root

############################################################
############################################################
############################################################

# Only the named package is exempt; its own dependencies still follow the
#  release-age policy unless they also match a pattern.
min-release-age-exclude[] = @(67)/*
