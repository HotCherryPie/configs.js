/* See: https://github.com/tsconfig/bases/blob/main/bases/node24.json */

{
  "$schema": "https://www.schemastore.org/tsconfig",
  "compilerOptions": {
    // See: https://github.com/microsoft/TypeScript/pull/60761
    "module": "nodenext",
    "moduleResolution": "nodenext",

    // Since node@24+ support .ts files
    "allowImportingTsExtensions": true,

    // https://github.com/tsconfig/bases/pull/310
    // https://github.com/tsconfig/bases/pull/343
    "lib": [
      "es2025", // Since 24.18 https://github.com/tsconfig/bases/pull/359
      "ESNext.Array",
      "ESNext.Collection",
      "ESNext.Error",
      "ESNext.Iterator",
      "ESNext.Promise"
    ],
    "types": ["node"]
  }
}
